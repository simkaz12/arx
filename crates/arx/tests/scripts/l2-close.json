    {"name": "cc-turn", "kind": "turn", "role": "operator", "contains": "hand:dispatch:hand-cc:"},
    {"name": "cc-gate", "kind": "gate", "tool": "dispatch", "verdict": "allow"},
    {"name": "spawn-h1", "kind": "spawn", "hand": "h1", "after": "cc-gate"},
