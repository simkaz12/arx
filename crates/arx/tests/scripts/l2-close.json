    {"name": "cx-gate", "kind": "gate", "tool": "dispatch", "verdict": "allow"},
    {"name": "spawn-h2", "kind": "spawn", "hand": "h2", "after": "cx-gate"},
    {"name": "ds-turn", "kind": "turn", "role": "operator", "contains": "hand:dispatch:hand-ds:"},
    {"name": "ds-gate", "kind": "gate", "tool": "dispatch", "verdict": "allow"},
    {"name": "spawn-h3", "kind": "spawn", "hand": "h3", "after": "ds-gate"},
    {"name": "fake-turn", "kind": "turn", "role": "operator", "contains": "hand:dispatch:fake:"},
    {"name": "fake-gate", "kind": "gate", "tool": "dispatch", "verdict": "allow"},
    {"name": "spawn-h4", "kind": "spawn", "hand": "h4", "after": "fake-gate"},
    {"name": "checkpoint", "kind": "checkpoint"},
    {"name": "judge-turn", "kind": "turn", "role": "operator", "contains": "hand:dispatch:judge:"},
