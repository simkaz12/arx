{
  "card": "L2-close",
  "operator": [
    "plain start",
    "store:recall:{\"scope\":\"testscope\",\"query\":\"what is the launch codename\"}",
    "file:list_files:{}",
    "store:decisions_query:{\"scope\":\"testscope\",\"query\":\"launch\"}",
