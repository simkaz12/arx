    {"name": "spawn-h5", "kind": "spawn", "hand": "h5", "after": "judge-gate"},
    {"name": "check-turn", "kind": "turn", "role": "operator", "contains": "plain check"},
    {"name": "delivered-h1", "kind": "delivered", "hand": "h1"},
    {"name": "verdict-turn-h1", "kind": "turn", "role": "arx", "contains": "[hand h1 verdict]"},
    {"name": "delivered-h2", "kind": "delivered", "hand": "h2"},
    {"name": "verdict-turn-h2", "kind": "turn", "role": "arx", "contains": "[hand h2 verdict]"},
    {"name": "delivered-h5", "kind": "delivered", "hand": "h5"},
    {"name": "schema-h5", "kind": "schema", "hand": "h5"},
    {"name": "verdict-turn-h5", "kind": "turn", "role": "arx", "contains": "[hand h5 verdict]", "after": "schema-h5"},
    {"name": "delivered-h3", "kind": "delivered", "hand": "h3"},
    {"name": "verdict-turn-h3", "kind": "turn", "role": "arx", "contains": "[hand h3 verdict]"},
    {"name": "delivered-h4", "kind": "delivered", "hand": "h4", "after": "checkpoint"},
